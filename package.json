{
  "name": "lellekclient",
  "productName": "LellekClient",
  "version": "2.1.1",
  "description": "Minecraft-Launcher für Windows und macOS – alle Versionen, Profile, Mod-Manager, Freunde, Server und Skins",
  "main": "src/main.js",
  "author": "Lellek",
  "license": "MIT",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "adm-zip": "^0.6.0",
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "nbt": "^0.8.1",
    "skinview3d": "^3.4.2",
    "tar": "^7.4.3"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.lellek.client",
    "productName": "LellekClient",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/mods/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LellekClient",
      "artifactName": "LellekClient-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "LellekClient-${version}-portable.exe"
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.games",
      "artifactName": "LellekClient-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "LellekClient ${version}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conlog06/LellekClient.git"
  }
}
